on early-init
    setprop sys.usb.controller musb-hdrc.0.auto
    setprop sys.usb.configfs 1

    # Load all recovery modules in exact vendor order
    insmod /lib/modules/sprd_wdt_fiq.ko
    insmod /lib/modules/sprd_sip_svc.ko
    insmod /lib/modules/sprd_systimer.ko
    insmod /lib/modules/sprd_time_sync.ko
    insmod /lib/modules/sprd_time_sync_cp.ko
    insmod /lib/modules/clk-sprd.ko
    insmod /lib/modules/ums9230-clk.ko
    insmod /lib/modules/spi-sprd-adi.ko
    insmod /lib/modules/sprd-sc27xx-spi.ko
    insmod /lib/modules/sc2730-regulator.ko
    insmod /lib/modules/rpmb.ko
    insmod /lib/modules/sprd_soc_id.ko
    insmod /lib/modules/ufs-sprd_qogirl6.ko
    insmod /lib/modules/sprd_hwspinlock.ko
    insmod /lib/modules/nvmem-sc27xx-efuse.ko
    insmod /lib/modules/nvmem_sprd_cache_efuse.ko
    insmod /lib/modules/nvmem_sprd_efuse.ko
    insmod /lib/modules/i2c-sprd.ko
    insmod /lib/modules/i2c-sprd-hw-v2.ko
    insmod /lib/modules/sprd-hwdvfs-ums9230-arch.ko
    insmod /lib/modules/sprd-hwdvfs-policy.ko
    insmod /lib/modules/sprd-cpufreq-public.ko
    insmod /lib/modules/sprd_7sreset.ko
    insmod /lib/modules/sprd_manufacturer_model.ko
    insmod /lib/modules/trusty.ko
    insmod /lib/modules/trusty-pm.ko
    insmod /lib/modules/trusty-log.ko
    insmod /lib/modules/trusty-irq.ko
    insmod /lib/modules/trusty-ipc.ko
    insmod /lib/modules/trusty-virtio.ko
    insmod /lib/modules/sprd_shm.ko
    insmod /lib/modules/core.ko
    insmod /lib/modules/gpio.ko
    insmod /lib/modules/pinctrl.ko
    insmod /lib/modules/pinctrl-sprd.ko
    insmod /lib/modules/pinctrl-sprd-qogirl6.ko
    insmod /lib/modules/gpio-eic-sprd.ko
    insmod /lib/modules/gpio-sprd.ko
    insmod /lib/modules/gpio-pmic-eic-sprd.ko
    insmod /lib/modules/sdhci-sprd.ko
    insmod /lib/modules/mmc_hsq.ko
    insmod /lib/modules/mmc_swcq.ko
    insmod /lib/modules/sprd_pmic_syscon.ko
    insmod /lib/modules/sprd_pmic_refout.ko
    insmod /lib/modules/device_info.ko
    insmod /lib/modules/sprd_power_manager.ko
    insmod /lib/modules/unisoc-mailbox.ko
    insmod /lib/modules/hardware_info.ko
    insmod /lib/modules/hq_hardware_info.ko
    insmod /lib/modules/sprd-dma.ko
    insmod /lib/modules/virt-dma.ko
    insmod /lib/modules/sprd-ion.ko
    insmod /lib/modules/unisoc-iommu.ko
    insmod /lib/modules/apsys-dvfs.ko
    insmod /lib/modules/sprd-gsp.ko
    insmod /lib/modules/lcd_bias_adjust.ko
    insmod /lib/modules/sprd_mipi.ko
    insmod /lib/modules/mipi_driver.ko
    insmod /lib/modules/sprd-drm.ko
    insmod /lib/modules/ilitek.ko
    insmod /lib/modules/chipone-tddi.ko
    insmod /lib/modules/sprd-nt36xxx.ko
    insmod /lib/modules/sprd-cts.ko
    insmod /lib/modules/sprd-focaltech.ko
    insmod /lib/modules/himax_mmi.ko
    insmod /lib/modules/focaltech_ft8756_spi_ts.ko
    insmod /lib/modules/leds-sc27xx-bltc.ko
    insmod /lib/modules/ledtrig-pattern.ko
    insmod /lib/modules/spi-sprd.ko
    insmod /lib/modules/pwm-sprd.ko
    insmod /lib/modules/rtc-sc27xx.ko
    insmod /lib/modules/sc27xx_adc.ko
    insmod /lib/modules/sc27xx-poweroff.ko
    insmod /lib/modules/sc27xx-vibra.ko
    insmod /lib/modules/extcon-usb-gpio.ko
    insmod /lib/modules/sprd_usbpinmux_qogirl6.ko
    insmod /lib/modules/phy-sprd-qogirl6.ko
    insmod /lib/modules/virtual_typec.ko
    insmod /lib/modules/sprd_tcpm.ko
    insmod /lib/modules/sc27xx_pd.ko
    insmod /lib/modules/sprd_vote.ko
    insmod /lib/modules/sprd_battery_info.ko
    insmod /lib/modules/sc27xx_fuel_gauge.ko
    insmod /lib/modules/rt9471-charger.ko
    insmod /lib/modules/sgm41512_chg.ko
    insmod /lib/modules/sgm4154x_chg.ko
    insmod /lib/modules/bq2560x-charger.ko
    insmod /lib/modules/sc2730_fast_charger.ko
    insmod /lib/modules/charger-manager.ko
    insmod /lib/modules/musb_hdrc.ko
    insmod /lib/modules/musb_sprd.ko
    insmod /lib/modules/zsmalloc.ko
    insmod /lib/modules/zram.ko

on init
    mkdir /config
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x1782
    write /config/usb_gadget/g1/idProduct 0x4d00
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "Realme"
    write /config/usb_gadget/g1/strings/0x409/product "RMX3624"
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    setprop sys.usb.ffs.aio_compat 1

on property:sys.usb.config=adb
    write /config/usb_gadget/g1/UDC "none"
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}
