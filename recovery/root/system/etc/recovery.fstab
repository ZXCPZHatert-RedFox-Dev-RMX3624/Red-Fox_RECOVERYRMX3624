#<src>                                          <mnt_point>              <type>  <mnt_flags and options>                                                                                                      <fs_mgr_flags>
system                                          /system                  erofs   ro,barrier=1                                                                                                                 wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system                                          /system                  ext4    ro,barrier=1                                                                                                                 wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system_ext                                      /system_ext              erofs   ro,barrier=1                                                                                                                 wait,slotselect,avb=vbmeta_system_ext,logical,first_stage_mount
system_ext                                      /system_ext              ext4    ro,barrier=1                                                                                                                 wait,slotselect,avb=vbmeta_system_ext,logical,first_stage_mount
vendor                                          /vendor                  erofs   ro,barrier=1                                                                                                                 wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
vendor                                          /vendor                  ext4    ro,barrier=1                                                                                                                 wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
product                                         /product                 erofs   ro,barrier=1                                                                                                                 wait,slotselect,avb=vbmeta_product,logical,first_stage_mount
product                                         /product                 ext4    ro,barrier=1                                                                                                                 wait,slotselect,avb=vbmeta_product,logical,first_stage_mount
vendor_dlkm                                     /vendor_dlkm             erofs   ro,barrier=1                                                                                                                 wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
/dev/block/by-name/metadata                     /metadata                ext4    nodev,noatime,nosuid,errors=panic                                                                                            wait,formattable,first_stage_mount,check
/dev/block/by-name/prodnv                       /mnt/vendor              ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc                                                                          wait,check
/dev/block/by-name/opporeserve                  /mnt/vendor/opporeserve  ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc                                                                          wait,formattable,check
/dev/block/by-name/cache                        /cache                   ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc                                                                          wait,check,formattable
/dev/block/by-name/userdata                     /data                    f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,inline_xattr,inline_data,inlinecrypt,fsync_mode=nobarrier         latemount,wait,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,reservedsize=128M,checkpoint=fs,formattable
/dev/block/by-name/misc                         /misc                    emmc    defaults                                                                                                                     defaults
/dev/block/by-name/boot                         /boot                    emmc    defaults                                                                                                                     slotselect
/dev/block/by-name/vendor_boot                  /vendor_boot             emmc    defaults                                                                                                                     slotselect
/dev/block/by-name/init_boot                    /init_boot               emmc    defaults                                                                                                                     slotselect
/dev/block/by-name/dtb                          /dtb                     emmc    defaults                                                                                                                     slotselect
/dev/block/by-name/dtbo                         /dtbo                    emmc    defaults                                                                                                                     slotselect
/dev/block/by-name/vbmeta                       /vbmeta                  emmc    defaults                                                                                                                     slotselect
